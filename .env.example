# Use a provider's Polygon Amoy HTTPS RPC endpoint (chain ID 80002).
POLYGON_AMOY_RPC_URL=https://your-amoy-rpc-provider.example
# Dedicated test-only wallet, funded with faucet POL; never use a mainnet key.
WALLET_PRIVATE_KEY=your_test_wallet_private_key_here
WALLET_ADDRESS=your_test_wallet_address_here

# Optional: retained at your request; unused by the supplied-URL pipeline.
SERPAPI_KEY=
